# Configuración del copiloto. Lo leen `apps/backend/brain/config.py` y main.py.
# Se puede pisar por línea de órdenes:  LLM_PORT=9090 python apps/backend/main.py

# --- Servidores llama.cpp de la placa (solo escuchan en 127.0.0.1) ---
LLM_HOST=127.0.0.1
LLM_PORT=8081
EMBED_HOST=127.0.0.1
EMBED_PORT=8082
VISION_HOST=127.0.0.1
VISION_PORT=8083

# --- Tiempos máximos en segundos (la placa lee a ~11 tokens/s) ---
LLM_TIMEOUT=120
EMBED_TIMEOUT=20
HEALTH_TIMEOUT=3

# --- Determinismo: los jueces exigen las mismas respuestas siempre ---
SEED=0
FALLBACK_ANSWER=D
TIME_LIMIT_SECONDS=60

# --- Embeddings: bge-small-en-v1.5 (384 dimensiones, modelo inglés) ---
EMBED_DIM=384
EMBED_BATCH=8
EMBED_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# --- Rutas (relativas a la raíz del repositorio) ---
DATA_DIR=data
DB_PATH=data/game_state.db
INDEX_PATH=data/index.db
